# UGC AI generation engine
# ComfyUI must be running separately with the Wan and Flux models installed.
COMFYUI_BASE_URL=http://localhost:8188
COMFYUI_TIMEOUT_MS=1200000
COMFYUI_POLL_INTERVAL_MS=3000

# Export these workflows from ComfyUI using "Save (API Format)".
# They must be API prompt JSON files, not regular UI workflow JSON.
COMFYUI_WAN_WORKFLOW_PATH=workflows/ugc-wan-video-api.json
COMFYUI_FLUX_WORKFLOW_PATH=workflows/ugc-flux-image-api.json

# Default UGC providers used when a campaign does not override them.
UGC_VIDEO_PROVIDER=fal-wan
UGC_IMAGE_PROVIDER=fal-flux

# fal.ai provider (no local GPU required)
FAL_KEY=
FAL_WEBHOOK_PUBLIC_URL=https://your-domain.com/api/fal/webhook
FAL_WEBHOOK_VERIFY_SIGNATURE=true
FAL_IMAGE_MODEL=fal-ai/flux/schnell
FAL_IMAGE_EDIT_MODEL=fal-ai/flux-pro/kontext
FAL_VIDEO_TEXT_MODEL=fal-ai/wan-25-preview/text-to-video
FAL_VIDEO_IMAGE_MODEL=fal-ai/wan-25-preview/image-to-video
FAL_VIDEO_PREMIUM_MODEL=fal-ai/seedance/v2/image-to-video
FAL_IMAGE_ESTIMATED_COST_USD=0
FAL_VIDEO_ESTIMATED_COST_USD=0

# ---------------------------------------------------------------------------
# Higgsfield (motor de generación imagen/video "cinema studio")
# Contrato real del SDK oficial @higgsfield/client:
#   Base URL: https://platform.higgsfield.ai
#   Auth: PAR key+secret → headers hf-api-key / hf-secret
# Credenciales del dashboard (API Management). SOLO server-side.
# ---------------------------------------------------------------------------
HIGGSFIELD_API_KEY=          # KEY_ID
HIGGSFIELD_API_SECRET=       # KEY_SECRET
# Alternativa combinada (cualquiera de las dos):  KEY_ID:KEY_SECRET
# HIGGSFIELD_CREDENTIALS=
# Base URL (no cambiar salvo entorno dedicado).
HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai
# Webhook público que recibe los callbacks de cierre de jobs.
HIGGSFIELD_WEBHOOK_PUBLIC_URL=https://your-domain.com/api/webhooks/higgsfield
# Verificación de firma del webhook (HMAC). "false" para desactivar en dev.
HIGGSFIELD_WEBHOOK_VERIFY_SIGNATURE=true
# Secreto del webhook (se envía al proveedor como webhook.secret).
HIGGSFIELD_WEBHOOK_SECRET=
# Markup global aplicado al costo del proveedor antes de cobrar créditos
# (1.0 = sin margen). Override por plan/tenant en el futuro.
GENERATION_MARKUP=1.0
# (Opcional) Preview de respaldo del catálogo si difiere.
# HIGGSFIELD_FALLBACK_PREVIEW=https://higgsfield.ai/_next/static/media/placeholder.jpg

# Optional. If absent, UGC scripts use the deterministic fallback.
OPENAI_API_KEY=
