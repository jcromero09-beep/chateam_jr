{
    "compilerOptions": {
      "target": "ES2022",
      "module": "ES2022",
      "moduleResolution": "node",
      "outDir": "dist",
      "rootDir": ".",
      "strict": false,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "declaration": true,
      "declarationMap": true,
      "sourceMap": true,
      "resolveJsonModule": true,
      "jsx": "react",
      "experimentalDecorators": true,
      "emitDecoratorMetadata": true,
      "allowSyntheticDefaultImports": true,
      "noImplicitAny": false,
      "strictNullChecks": false,
      "noEmitOnError": false,
      "verbatimModuleSyntax": false,
      "useDefineForClassFields": false
    },
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": [
      "node_modules",
      "dist",
      "_legacy",
      "src10",
      "audit-service",
      "frontend",
      "frontend-react",
      "tests",
      "examples",
      "meta-marketing",
      "monitoring",
      "scripts",
      "debug",
      "queuesoriginal.ts",
      "**/*.test.ts",
      "**/*.spec.ts",
      "config/test-*.ts"
    ]
  }
