{
  "name": "chateam-platform",
  "version": "1.1.0",
  "type": "module",
  "description": "Plataforma omnicanal completa para gestión de comunicaciones empresariales",
  "main": "dist/server-simple.js",
  "scripts": {
    "dev": "tsx watch server-simple.ts",
    "dev:backend": "tsx watch server-simple.ts",
    "dev:worker": "tsx watch worker.ts",
    "build": "tsc -p tsconfig.json && tsc-esm-fix --tsconfig=tsconfig.json --ext=.js",
    "start": "tsx server-simple.ts",
    "start:backend": "tsx server-simple.ts",
    "start:worker": "tsx worker.ts",
    "start:pm2": "pm2 start ecosystem.config.cjs",
    "db:create": "node dist/scripts/createDatabase.js",
    "db:migrate": "node dist/scripts/runMigrations.js",
    "db:seed": "node dist/scripts/runSeeds.js",
    "db:check": "node dist/scripts/checkDatabase.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --config jest.integration.config.cjs",
    "test:golden": "jest --config jest.db.config.cjs --forceExit",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "test:smoke:rbac": "node tests/rbac-smoke.mjs",
    "lint": "eslint controllers services models routes middleware helpers utils config --ext .ts,.tsx",
    "lint:fix": "eslint controllers services models routes middleware helpers utils config --ext .ts,.tsx --fix",
    "format": "prettier --write \"{controllers,services,models,routes,middleware,helpers,utils,config}/**/*.{ts,tsx}\"",
    "health:check": "./scripts/health-check.sh",
    "setup": "./scripts/setup.sh",
    "deploy": "./scripts/deploy.sh",
    "backup": "./scripts/backup.sh",
    "recovery": "./scripts/recovery.sh $1",
    "monitoring": "./scripts/monitoring.sh",
    "cleanup": "./scripts/cleanup.sh",
    "update": "./scripts/update.sh",
    "ssl:setup": "./scripts/ssl-setup.sh $1",
    "logs": "./scripts/logs.sh $1 $2",
    "validate:whatsapp": "node scripts/validate-whatsapp-cloud-api.js",
    "ugc:check": "tsx scripts/validate-ugc-comfyui.ts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "type-check:files": "./scripts/tsc-check.sh",
    "test:unit": "jest",
    "format:check": "prettier --check \"{controllers,services,models,routes,middleware,helpers,utils,config}/**/*.{ts,tsx}\"",
    "format:check:diff": "./scripts/format-check-diff.sh"
  },
