{
  "name": "@chateam/audit-service",
  "version": "1.0.0",
  "description": "Microservicio de auditoría IA para análisis automático de campañas con GPT-4",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "docker:build": "docker build -t chateam/audit-service .",
    "docker:run": "docker run -p 3001:3001 chateam/audit-service"
  },
  "keywords": ["ai", "audit", "campaigns", "gpt", "analysis"],
  "author": "Chateam",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "openai": "^4.20.0",
    "axios": "^1.6.0",
    "joi": "^17.11.0",
    "winston": "^3.11.0",
    "bull": "^4.12.0",
    "redis": "^4.6.0",
    "moment": "^2.29.4",
    "pdf-lib": "^1.17.1",
    "canvas": "^2.11.2",
    "chart.js": "^4.4.0",
    "chartjs-node-canvas": "^4.1.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.0.0",
    "@types/bull": "^4.10.0",
    "typescript": "^5.0.0",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  }
}